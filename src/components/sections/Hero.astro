---
import { site } from "../../data/site";
import Typewriter from "../Typewriter.tsx";
import { Github, Linkedin, Mail, ArrowDown } from "lucide-react";
import { FX_DISABLED } from "../../lib/fx";
const compact = FX_DISABLED;
---

<section
  id="home"
  class:list={[
    "relative flex items-center overflow-hidden",
    compact ? "min-h-[700px]" : "min-h-screen",
  ]}
>

  <!-- Atmospheric accent glow -->
  <div
    class="glow-accent pointer-events-none absolute left-1/2 top-1/3 -z-0 h-[42rem] w-[42rem] -translate-x-1/2 -translate-y-1/2 blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div class="shell section relative z-10 w-full">
    <p class="eyebrow mb-5">Quant · Data Scientist · Milwaukee</p>

    <h1 class="text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl lg:text-6xl">
      {site.greeting}
    </h1>

    <p class="mt-3 text-2xl font-semibold tracking-tight sm:text-3xl lg:text-4xl">
      <Typewriter client:load phrases={[...site.taglines]} />
    </p>

    <p class="mt-6 max-w-xl text-base leading-relaxed text-[var(--color-mute-400)] sm:text-lg">
      I build systematic trading strategies and financial machine-learning systems —
      from reinforcement-learning agents to production data pipelines.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        href="#projects"
        class="glass glass-interactive rounded-full px-5 py-2.5 text-sm font-medium text-white"
      >
        View my work
      </a>
      <a
        href={site.resume}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full border border-[var(--color-glass-12)] px-5 py-2.5 text-sm font-medium text-[var(--color-mute-300)] transition-colors hover:border-[var(--color-accent)] hover:text-white"
      >
        Résumé
      </a>

      <div class="ml-1 flex items-center gap-1">
        <a
          href={site.socials.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--color-mute-400)] transition-colors hover:text-white"
        >
          <Github className="h-5 w-5" />
        </a>
        <a
          href={site.socials.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--color-mute-400)] transition-colors hover:text-white"
        >
          <Linkedin className="h-5 w-5" />
        </a>
        <a
          href={`mailto:${site.email}`}
          aria-label="Email"
          class="inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--color-mute-400)] transition-colors hover:text-white"
        >
          <Mail className="h-5 w-5" />
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll cue -->
  <a
    href="#about"
    aria-label="Scroll to About"
    class="absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-[var(--color-mute-500)] transition-colors hover:text-white"
  >
    <ArrowDown className="h-5 w-5 animate-bounce" />
  </a>
</section>
