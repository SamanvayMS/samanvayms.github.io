---
interface Props {
  eyebrow?: string;
  heading: string;
  sub?: string;
  align?: "left" | "center";
}
const { eyebrow, heading, sub, align = "left" } = Astro.props;
---

<div class:list={["max-w-2xl", { "mx-auto text-center": align === "center" }]}>
  {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{heading}</h2>
  {sub && <p class="mt-3 text-[var(--color-mute-400)]">{sub}</p>}
</div>
