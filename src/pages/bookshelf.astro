---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedBackground from "../components/AnimatedBackground.tsx";
import BookshelfGrid from "../components/BookshelfGrid.tsx";
import { site } from "../data/site";
import { ArrowLeft } from "lucide-react";
---

<BaseLayout title={`Bookshelf — ${site.short}`}>
  <!-- Animated candlestick background behind content -->
  <AnimatedBackground client:idle mode="candles" />

  <main class="relative z-10 min-h-screen px-4 py-20 sm:px-6 lg:px-8">
    <header class="mb-8">
      <a
        href="/"
        class="mb-6 inline-flex items-center gap-2 text-[var(--color-mute-300)] transition-colors hover:text-white"
      >
        <ArrowLeft className="h-5 w-5" /> Back to Portfolio
      </a>
      <h1
        class="bg-gradient-to-r from-white to-[var(--color-mute-300)] bg-clip-text text-4xl font-bold leading-tight text-transparent sm:text-5xl"
      >
        My Bookshelf
      </h1>
    </header>

    <BookshelfGrid client:visible />
  </main>
</BaseLayout>
