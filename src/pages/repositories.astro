---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnimatedBackground from "../components/AnimatedBackground.tsx";
import RepositoriesGrid from "../components/RepositoriesGrid.tsx";
import { site } from "../data/site";
import { ArrowLeft } from "lucide-react";
---

<BaseLayout title={`Repositories · ${site.short}`}>
  <!-- Animated candlestick background behind content -->
  <AnimatedBackground client:idle mode="candles" />

  <main class="relative z-10 min-h-screen px-4 py-20 sm:px-6 lg:px-8">
    <header class="mb-8">
      <a
        href="/"
        class="mb-6 inline-flex items-center gap-2 text-[var(--color-mute-300)] transition-colors hover:text-white"
      >
        <ArrowLeft className="h-5 w-5" /> Back to Portfolio
      </a>
      <h1
        class="bg-gradient-to-r from-white to-[var(--color-mute-300)] bg-clip-text text-4xl font-bold leading-tight text-transparent sm:text-5xl"
      >
        Repositories
      </h1>
      <p class="mt-4 max-w-2xl text-[var(--color-mute-300)]">
        A selection of my public projects. Each card opens the project's own
        hosted page, or its source where there isn't one.
        <a
          class="text-[var(--color-accent-light)] transition-colors hover:text-white"
          href={site.socials.github}
        >
          Browse everything on GitHub &nearr;
        </a>
      </p>
    </header>

    <RepositoriesGrid client:visible />
  </main>
</BaseLayout>
